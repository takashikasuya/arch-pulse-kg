# BIR SHACL shapes — bir_id URN pattern + cardinality constraints
# Ref: interfaces/IF-KG-BIR/bir-id-urn-spec.md, ADR-002, ADR-006

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix bir:  <https://arch-pulse.example/ns/bir#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# IRI of every bir:Entity must match urn:bir:{kind}:{uuid} pattern
bir:BirIdShape
    a sh:NodeShape ;
    sh:targetClass bir:Entity ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^urn:bir:(building|floor|space|zone|surface|opening|device|point|system|geometry|schedule|tenant|policy|dataset|model|run|visitor|robot|ctrl-seq):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
    sh:message "bir_id IRI must match urn:bir:{kind}:{uuid}" .

# bir:status is required and must be a recognised lifecycle value
bir:StatusShape
    a sh:NodeShape ;
    sh:targetClass bir:Entity ;
    sh:property [
        sh:path bir:status ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^(Active|Draft|Archived|Superseded)$" ;
        sh:message "bir:status must be one of Active | Draft | Archived | Superseded" ;
    ] .

# External-ref properties are single-valued (REQ-SOS-028 §5.2)
bir:ExternalRefCardinalityShape
    a sh:NodeShape ;
    sh:targetClass bir:Entity ;
    sh:property [ sh:path bir:hasIfcGuid         ; sh:maxCount 1 ] ;
    sh:property [ sh:path bir:hasRevitElementId  ; sh:maxCount 1 ] ;
    sh:property [ sh:path bir:hasGbxmlSpaceId    ; sh:maxCount 1 ] ;
    sh:property [ sh:path bir:hasEnergyPlusZone  ; sh:maxCount 1 ] ;
    sh:property [ sh:path bir:hasP223SpaceUri    ; sh:maxCount 1 ] ;
    sh:property [ sh:path bir:hasBasPointPrefix  ; sh:maxCount 1 ] ;
    sh:property [ sh:path bir:hasBrickUri        ; sh:maxCount 1 ] .

# Beacon shape — urn:beacon:{hardware-id} linked to space bir_id (Issue #1, Slice 6-a)
# Beacons use their own URI scheme and are NOT bir:Entity instances.
bir:BeaconShape
    a sh:NodeShape ;
    sh:targetClass bir:Beacon ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^urn:beacon:[A-Za-z0-9][A-Za-z0-9\\-_:.]*$" ;
    sh:message "Beacon IRI must match urn:beacon:{hardware-id}" ;
    sh:property [
        sh:path bir:locatedIn ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "bir:locatedIn is required (exactly once) and must be an IRI" ;
    ] ;
    sh:property [
        sh:path bir:beaconProtocol ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path bir:floor ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .
